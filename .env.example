# SchemeSaathi Environment Configuration

# Groq API Key (for multilingual AI natural language explanations and interactive chat)
# Optional in dev: falls back to high-fidelity built-in rule-based conversational model if absent
GROQ_API_KEY=

# Mapbox Access Token (for Interactive Channel Partner locator map)
# Optional in dev: includes full searchable/filterable low-bandwidth fallback table if absent
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase Configuration (PostgreSQL Database)
# Optional in dev: falls back to comprehensive embedded database of schemes and 30+ channel partners if absent
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
